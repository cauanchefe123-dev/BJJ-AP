{
  "entities": {
    "students": {
      "title": "Students",
      "description": "Registered students",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "belt": { "type": "string" },
        "stripes": { "type": "number" },
        "approvalStatus": { "type": "string" },
        "active": { "type": "boolean" }
      },
      "required": ["id", "name"]
    },
    "teachers": {
      "title": "Teachers",
      "description": "Registered instructors",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "belt": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "classes": {
      "title": "Classes",
      "description": "BJJ Classes and schedules",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      },
      "required": ["id", "name"]
    },
    "attendances": {
      "title": "Attendances",
      "description": "Attendance check-in records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "classId": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "studentId", "classId"]
    },
    "payments": {
      "title": "Payments",
      "description": "Tuition and payment records",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "studentId"]
    },
    "academyConfig": {
      "title": "Academy Config",
      "description": "Academy general settings",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" }
      }
    },
    "timer_sync": {
      "title": "Timer Sync",
      "description": "Real-time tatame timer and scoreboard state for TV mirroring",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "tatameId": { "type": "string" },
        "tatameName": { "type": "string" },
        "timerMode": { "type": "string" },
        "status": { "type": "string" },
        "timeRemaining": { "type": "number" },
        "targetEndTime": { "type": "number" },
        "totalDuration": { "type": "number" },
        "currentRound": { "type": "number" },
        "totalRounds": { "type": "number" },
        "isResting": { "type": "boolean" },
        "athlete1Name": { "type": "string" },
        "athlete2Name": { "type": "string" },
        "athlete1Belt": { "type": "string" },
        "athlete2Belt": { "type": "string" },
        "score1": { "type": "number" },
        "score2": { "type": "number" },
        "advantages1": { "type": "number" },
        "advantages2": { "type": "number" },
        "penalties1": { "type": "number" },
        "penalties2": { "type": "number" },
        "soundType": { "type": "string" },
        "soundTimestamp": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["id", "status"]
    }
  }
